# 火山引擎 Agent Plan（LLM + 生图 + 语音）
ARK_API_KEY=ark-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 模型名称
LLM_MODEL=deepseek-v4-flash-ga-260731
IMAGE_MODEL=doubao-seedream-5-0-260128

# 视频生成（阿里云 DashScope 万相 Wan，与 config.py 一致）
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
VIDEO_MODEL=wan2.7-r2v-2026-06-12

# 语音合成
VOLC_TTS_APP_ID=你的AppID
VOLC_TTS_ACCESS_TOKEN=你的AccessToken
VOLC_TTS_RESOURCE_ID=seed-tts-2.0

# Redis（独立容器 ntd-redis，宿主端口 6381）
REDIS_URL=redis://:123456@localhost:6381/0

# 通用
OUTPUT_DIR=./projects
IMAGE_STYLE=anime
VIDEO_DURATION=5
# 生图参考图裁成"头部+肩部"再作参考（避免模型照抄角色设定图的全身站姿/白底构图）
IMAGE_REF_BUST_CROP=true

# 本地音频素材库（音效/环境音/BGM）
SFX_ENABLED=true
AMBIENCE_ENABLED=true
BGM_ENABLED=true
SFX_VOLUME=0.8
AMBIENCE_VOLUME=0.4
BGM_VOLUME=0.22
BGM_DUCK=true
DUCK_SFX_AMB=true
BGM_CROSSFADE=0.4
# 保留 AI 视频自带音轨？默认 false（丢弃 i2v 自动音，声音全由本地素材库提供）
KEEP_VIDEO_AUDIO=false
# 音效按画面运动峰值校正（把音效吸附到画面真的在动的那一下）
SFX_MOTION_ALIGN=true
SFX_ALIGN_WINDOW=0.6
